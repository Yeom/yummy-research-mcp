# Copy this file to .env and fill in values locally. Never commit .env.
# FRED API key: required for the authenticated daily observations API.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: OpenDART API key for Korean company filings.
# https://opendart.fss.or.kr/
DART_API_KEY=

# Optional: SEC fair-access identity for US company filings.
# Set to your application/organization name and contact email.
SEC_USER_AGENT=

# Optional: absolute SQLite path. Blank uses this repository's state/market_data.db.
YUMMY_MARKET_DB=
